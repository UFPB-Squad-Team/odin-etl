# =============================================================
# ODIN-ETL — Variáveis de Ambiente
#
# Desenvolvimento: cp .env.example .env
# Produção:        cp .env.example .env.prod  (e preencha tudo)
# =============================================================

# -------------------------------------------------------------
# MongoDB
# Dev local:   mongodb://localhost:27017
# Dev Docker:  mongodb://mongo:27017          (nome do service)
# Produção:    mongodb://odin_user:<senha>@mongo:27017/odin?authSource=odin
# Atlas:       mongodb+srv://...
# -------------------------------------------------------------
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=odin_dev

# Só necessário no docker-compose.prod.yml para interpolação
# (a senha real fica em secrets/mongo_password.txt)
MONGO_PASSWORD=
MONGO_ADMIN_PASSWORD=

# -------------------------------------------------------------
# Geocodificação
# -------------------------------------------------------------
GOOGLE_API_KEY=

# -------------------------------------------------------------
# Storage Backend
# local  — salva em data/ (padrão para dev)
# r2     — Cloudflare R2 (requer R2_* abaixo)
# -------------------------------------------------------------
STORAGE_BACKEND=local

R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=odin-datalake

# -------------------------------------------------------------
# Configurações gerais
# -------------------------------------------------------------
LOG_LEVEL=INFO
TZ=America/Recife
