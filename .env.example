# =============================================================
# ODIN-ETL — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores
# cp .env.example .env
# =============================================================

# -------------------------------------------------------------
# MongoDB
# URI de conexão com o MongoDB. Para desenvolvimento local via
# Docker Compose, use o valor abaixo. Para Atlas, substitua
# pela connection string fornecida pelo Atlas.
# Formato: mongodb://<host>:<porta>
# -------------------------------------------------------------
MONGO_URI=mongodb://localhost:27017

# Nome do banco de dados no MongoDB onde os dados serão gravados.
MONGO_DB_NAME=odin_dev

# -------------------------------------------------------------
# Geocodificação
# Chave da API de geocodificação. Atualmente o projeto suporta
# Google Maps Geocoding API. Alternativas (Nominatim, OpenCage)
# estão sendo avaliadas — ver docs/pipelines/pipelinesGeocoding/
# Deixe em branco se ainda não tiver uma chave; o pipeline de
# geocodificação não será executável sem ela.
# -------------------------------------------------------------
GOOGLE_API_KEY=

# -------------------------------------------------------------
# Storage Backend
# Define onde os dados intermediários e processados são salvos.
# Valores aceitos:
#   local  — salva em data/ na raiz do projeto (padrão para dev)
#   r2     — salva no Cloudflare R2 (requer R2_* abaixo)
# -------------------------------------------------------------
STORAGE_BACKEND=local

# -------------------------------------------------------------
# Cloudflare R2 (necessário apenas se STORAGE_BACKEND=r2)
# Endpoint no formato: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# Credenciais geradas em: Cloudflare Dashboard → R2 → Manage API Tokens
# -------------------------------------------------------------
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=odin-datalake

# -------------------------------------------------------------
# Configurações gerais
# -------------------------------------------------------------
# Nível de log: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Timezone do container/processo
TZ=America/Recife
